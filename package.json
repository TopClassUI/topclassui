{
  "name": "topclassui-repo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "lint": "pnpm --filter topclassui lint",
    "typecheck": "pnpm --filter topclassui typecheck",
    "test": "pnpm --filter topclassui test",
    "check:structure": "pnpm --filter topclassui check:structure",
    "check:boundaries": "pnpm --filter topclassui check:boundaries",
